{
  "name": "@alexeiled/pi-subagents-bridge",
  "version": "0.4.2",
  "description": "Protocol adapter that lets @tintinweb/pi-tasks TaskExecute spawn nicobailon/pi-subagents.",
  "keywords": [
    "bridge",
    "pi-extension",
    "pi-package",
    "pi-subagents",
    "pi-tasks",
    "rpc"
  ],
  "homepage": "https://github.com/alexei-led/pi-subagents-bridge#readme",
  "bugs": {
    "url": "https://github.com/alexei-led/pi-subagents-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/pi-subagents-bridge.git"
  },
  "files": [
    "src/index.ts",
    "src/operation-journal.ts",
    "src/plan-exec-rpc.ts",
    "src/workflow-spawn.ts",
    "src/execution-lifetime.ts",
    "src/native-proof.ts"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "check": "biome check --error-on-warnings . && npm run tsc",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pack:dry": "npm pack --dry-run",
    "publish:dry": "npm publish --dry-run",
    "test:all": "npm run check && npm test && npm run pack:dry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@tintinweb/pi-tasks": "0.9.0",
    "@types/node": "^24.10.0",
    "jiti": "^2.7.0",
    "pi-subagents": "^0.70.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@12.0.2",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/alexei-led/pi-subagents-bridge/main/assets/bridge.svg"
  }
}
